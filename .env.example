# ==============================================================================
# agent-lab Configuration Template
# ==============================================================================

# Environment mode: development, staging, production
AGENT_LAB_ENV=development

# Workspace Root (defaults to current working directory)
AGENT_LAB_WORKSPACE=.

# Default Storage Directory for checkpoints and receipts
AGENT_LAB_STORAGE_DIR=.agentlab

# Pre-flight Solana RPC endpoint (optional, defaults to https://api.mainnet-beta.solana.com)
AGENT_LAB_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Consensus parameters
AGENT_LAB_CONSENSUS_QUORUM_RATIO=0.67
AGENT_LAB_BFT_TIMEOUT_MS=5000

# Evaluation harness settings
AGENT_LAB_EVAL_TIMEOUT_SECS=30
AGENT_LAB_MAX_WORKERS=4
